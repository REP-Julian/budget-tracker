{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudgetTracker",
  "version": "1.1.2",
  "identifier": "com.julian.budgettracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Budget Tracker",
        "width": 420,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "budgettracker"
          ],
          "host": "auth-callback"
        }
      ],
      "desktop": {
        "schemes": [
          "budgettracker"
        ]
      }
    },
    "opener": {}
  }
}
